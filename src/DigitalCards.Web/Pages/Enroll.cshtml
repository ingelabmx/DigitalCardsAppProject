@page "/Enroll/{businessToken}"
@model DigitalCards.Web.Pages.EnrollModel
@{
    ViewData["Title"] = "Registra tu tarjeta de lealtad";
    ViewData["Description"] = "Regístrate y obtén tu tarjeta de lealtad digital. Acumula sellos y canjea recompensas.";
    ViewData["OgTitle"] = "Puntelio — Registra tu tarjeta de lealtad";
    ViewData["OgDescription"] = "Únete al programa de lealtad. Acumula sellos digitales y canjea recompensas en tu próxima visita.";
}

@if (Model.IsUnavailable)
{
    <div class="p-auth-simple" data-testid="public-business-enrollment-page">
        <div class="p-card">
            <h1 class="p-page-heading mb-2">Registro no disponible</h1>
            <p class="p-page-sub mb-3" data-testid="public-business-enrollment-unavailable">
                El link no es valido o el negocio no esta activo para registro.
            </p>
            <a class="btn btn-outline-secondary" asp-page="/Index">Volver al inicio</a>
        </div>
    </div>
}
else
{
    <section class="auth-gateway public-enrollment-shell"
             style="--enroll-primary:@Model.PrimaryColor;--enroll-secondary:@Model.SecondaryColor;"
             data-testid="public-business-enrollment-page">
        <div class="auth-copy-panel p-enroll-copy">
            <div>
                <div class="public-business-brand" data-testid="public-business-enrollment-brand">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                    {
                        <img src="@Model.LogoPath" alt="" />
                    }
                    else
                    {
                        <span class="p-enroll-initials">@Model.BusinessInitials</span>
                    }
                </div>
                <span class="p-eyebrow">@Model.ProgramName</span>
                <h1 data-testid="public-business-enrollment-business">@Model.BusinessName</h1>
                <p>@Model.ProgramDescription</p>
            </div>
            <div class="p-enroll-wallet-card">
                <span>@Model.BusinessName</span>
                <strong>Tu tarjeta digital</strong>
                <p>Instala en Apple Wallet o Google Wallet despues del registro.</p>
            </div>
        </div>

        <div class="auth-form-card">
            <div class="auth-form-heading">
                <div>
                    <h2>Recibe tu link Wallet</h2>
                    <p>Registra tus datos para quedar asociado a este negocio.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success" role="status" data-testid="public-business-enrollment-success">
                    @Model.StatusMessage
                    @if (!string.IsNullOrWhiteSpace(Model.WalletLink))
                    {
                        <div class="mt-2">
                            <a class="btn btn-primary btn-sm" href="@Model.WalletLink" data-testid="public-business-enrollment-wallet-link">Abrir Wallet</a>
                        </div>
                    }
                </div>
            }

            <form method="post" data-testid="public-business-enrollment-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Input.UserName" class="form-label"></label>
                    <input asp-for="Input.UserName"
                           class="form-control form-control-lg"
                           pattern="[A-Za-z0-9]+"
                           autocomplete="username"
                           autocapitalize="none"
                           spellcheck="false"
                           data-testid="public-enroll-username" />
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control form-control-lg" data-testid="public-enroll-first-name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.LastName" class="form-label"></label>
                        <input asp-for="Input.LastName" class="form-control form-control-lg" data-testid="public-enroll-last-name" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control form-control-lg" data-testid="public-enroll-email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control form-control-lg" data-testid="public-enroll-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Input.AcceptTerms" class="form-check-input" data-testid="public-enroll-accept-terms" />
                    <label asp-for="Input.AcceptTerms" class="form-check-label">
                        Acepto los <a asp-page="/Privacy" target="_blank" rel="noopener">terminos y privacidad</a>.
                    </label>
                    <span asp-validation-for="Input.AcceptTerms" class="text-danger"></span>
                </div>

                <button class="btn btn-primary btn-lg w-100" type="submit" data-testid="public-enroll-submit">Registrarme</button>
            </form>

            <div class="p-enroll-divider">
                <span>¿Ya tienes cuenta en Puntelio?</span>
            </div>

            <button type="button"
                    id="btn-existing-account"
                    class="btn btn-outline-primary w-100"
                    onclick="toggleExistingForm()"
                    data-testid="public-enroll-existing-toggle">
                Ya tengo cuenta
            </button>

            <div id="existing-account-form"
                 style="@(Model.ShowExistingForm ? "" : "display:none")"
                 class="mt-3"
                 data-testid="public-enroll-existing-form">
                @if (!string.IsNullOrWhiteSpace(Model.ExistingFormError))
                {
                    <div class="alert alert-danger" data-testid="public-enroll-existing-error">
                        @Model.ExistingFormError
                    </div>
                }
                <form method="post" asp-page-handler="EnrollExisting">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Usuario o correo</label>
                        <input type="text"
                               name="usernameOrEmail"
                               class="form-control form-control-lg"
                               placeholder="Tu usuario o correo de Puntelio"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               required
                               data-testid="public-enroll-existing-username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password"
                               name="password"
                               class="form-control form-control-lg"
                               placeholder="Tu contraseña de Puntelio"
                               autocomplete="current-password"
                               required
                               data-testid="public-enroll-existing-password" />
                    </div>
                    <button type="submit"
                            class="btn btn-primary btn-lg w-100"
                            data-testid="public-enroll-existing-submit">
                        Enrolarme con mi cuenta
                    </button>
                </form>
            </div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleExistingForm() {
            document.getElementById('existing-account-form').style.display = 'block';
            document.getElementById('btn-existing-account').style.display = 'none';
        }
        @if (Model.ShowExistingForm)
        {
            <text>
            document.getElementById('btn-existing-account').style.display = 'none';
            </text>
        }
    </script>
}
